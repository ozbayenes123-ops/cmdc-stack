{
  "mcpServers": {
    "shamela": {
      "transport": "stdio",
      "enabled": true,
      "command": "node",
      "args": [
        "C:\\dev\\mcp\\shamela-mcp\\dist\\index.js"
      ],
      "env": {
        "SHAMELA_INSTALL_ROOT": "C:\\shamela4",
        "SHAMELA_JRE": "java"
      }
    },
    "makale": {
      "transport": "stdio",
      "enabled": true,
      "command": "uv",
      "args": [
        "run",
        "--project",
        "C:\\dev\\mcp\\makale",
        "makale",
        "serve"
      ]
    },
    "yargi": {
      "transport": "stdio",
      "enabled": true,
      "command": "uv",
      "args": [
        "run",
        "--project",
        "C:\\dev\\mcp\\yargi-mcp",
        "yargi-mcp"
      ]
    },
    "hyperframes-local": {
      "transport": "stdio",
      "enabled": true,
      "command": "node",
      "args": [
        "C:\\dev\\mcp\\hyperframes-mcp\\index.mjs"
      ]
    },
    "zotero": {
      "transport": "stdio",
      "enabled": true,
      "command": "uv",
      "args": [
        "run",
        "--project",
        "C:\\dev\\mcp\\zotero-mcp-src",
        "zotero-mcp"
      ],
      "env": {
        "ZOTERO_LOCAL": "true"
      }
    },
    "notion": {
      "transport": "http",
      "enabled": true,
      "url": "https://mcp.notion.com/mcp"
    },
    "bridge": {
      "transport": "stdio",
      "enabled": true,
      "command": "uv",
      "args": [
        "run",
        "--project",
        "C:\\dev\\mcp\\bridge-mcp",
        "bridge-mcp"
      ]
    }
  }
}