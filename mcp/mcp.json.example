                                                          ]
                                             },
                       "chatcut":  {
                                       "transport":  "stdio",
                                       "enabled":  true,
                                       "command":  "C:\\Users\\Enes Özbay\\AppData\\Local\\Programs\\ChatCut\\ChatCut.exe",
